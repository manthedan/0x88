+def test_rewrite_to_shuffle_stride_multiple_of_vector_lanes():
+    transform = tvm.tirx.transform.PointerValueTypeRewrite()
+
+    @I.ir_module
+    class Before:
+        @T.prim_func(s_tir=True)
+        def main(A: T.Buffer((8,), "float32"), B: T.Buffer((2,), "float32")):
+            A_local = T.alloc_buffer((8,), scope="local")
+            for i in range(4):
+                A_local[i * 2 : i * 2 + 2] = A[i * 2 : i * 2 + 2]
+            for i in range(2):
+                B[i] = A_local[i * 4] + A_local[i * 4 + 1]
+
+    @I.ir_module
+    class Expected:
+        @T.prim_func(s_tir=True)
+        def main(A: T.Buffer((4,), "float32x2"), B: T.Buffer((2,), "float32")):
+            A_local = T.alloc_buffer((4,), "float32x2", scope="local")
+            for i in range(4):
+                A_local[T.Div(i * 2, 2)] = A[T.Div(i * 2, 2)]
+            for i in range(2):
+                B[i] = T.Shuffle([A_local[T.Div(i * 4, 2)]], [0]) + T.Shuffle(
+                    [A_local[T.Div(i * 4 + 1, 2)]], [1]
+                )
+
+    After = transform(Before)
+    tvm.ir.assert_structural_equal(After, Expected)
+
+
