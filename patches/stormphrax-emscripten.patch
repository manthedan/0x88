+/*
+ * Stormphrax browser port WebAssembly SIMD backend.
+ * Derived from the upstream AVX2 backend and mapped to Emscripten's SSE
+ * intrinsic compatibility layer (one 128-bit vector per operation).
+ */
+#pragma once
+
+#include "../../types.h"
+#include "../../arch.h"
+#include "../align.h"
+
+#if SP_HAS_WASM_SIMD
+
+#include <smmintrin.h>
+#include <tmmintrin.h>
+#if defined(__wasm_relaxed_simd__)
+#include <wasm_simd128.h>
+#endif
+
+namespace stormphrax::util::simd {
+    using VectorU8 = __m128i;
+    using VectorU16 = __m128i;
+    using VectorI8 = __m128i;
+    using VectorI16 = __m128i;
+    using VectorI32 = __m128i;
+
+    constexpr std::uintptr_t kAlignment = sizeof(__m128i);
+    constexpr bool kPackNonSequential = false;
+    constexpr usize kPackGrouping = 1;
+    constexpr std::array kPackOrdering = {0};
+
+    namespace impl {
+        SP_ALWAYS_INLINE_NDEBUG inline VectorU8 zeroU8() { return _mm_setzero_si128(); }
+        SP_ALWAYS_INLINE_NDEBUG inline VectorU8 loadU8(const void* ptr) {
+            assert(isAligned<kAlignment>(ptr));
+            return _mm_load_si128(static_cast<const VectorU8*>(ptr));
+        }
+        SP_ALWAYS_INLINE_NDEBUG inline void storeU8(void* ptr, VectorU8 v) {
+            assert(isAligned<kAlignment>(ptr));
+            _mm_store_si128(static_cast<VectorU8*>(ptr), v);
+        }
+
+        SP_ALWAYS_INLINE_NDEBUG inline VectorU16 zeroU16() { return _mm_setzero_si128(); }
+        SP_ALWAYS_INLINE_NDEBUG inline VectorU16 loadU16(const void* ptr) {
+            assert(isAligned<kAlignment>(ptr));
+            return _mm_load_si128(static_cast<const VectorU16*>(ptr));
+        }
+        SP_ALWAYS_INLINE_NDEBUG inline void storeU16(void* ptr, VectorU16 v) {
+            assert(isAligned<kAlignment>(ptr));
+            _mm_store_si128(static_cast<VectorU16*>(ptr), v);
+        }
+
+        SP_ALWAYS_INLINE_NDEBUG inline VectorI8 zeroI8() { return _mm_setzero_si128(); }
+        SP_ALWAYS_INLINE_NDEBUG inline VectorI8 set1I8(i8 v) { return _mm_set1_epi8(v); }
+        SP_ALWAYS_INLINE_NDEBUG inline VectorI8 loadI8(const void* ptr) {
+            assert(isAligned<kAlignment>(ptr));
+            return _mm_load_si128(static_cast<const VectorI8*>(ptr));
+        }
+        SP_ALWAYS_INLINE_NDEBUG inline void storeI8(void* ptr, VectorI8 v) {
+            assert(isAligned<kAlignment>(ptr));
+            _mm_store_si128(static_cast<VectorI8*>(ptr), v);
+        }
+        SP_ALWAYS_INLINE_NDEBUG inline VectorI8 minI8(VectorI8 a, VectorI8 b) { return _mm_min_epi8(a, b); }
+        SP_ALWAYS_INLINE_NDEBUG inline VectorI8 maxI8(VectorI8 a, VectorI8 b) { return _mm_max_epi8(a, b); }
+        SP_ALWAYS_INLINE_NDEBUG inline VectorI8 clampI8(VectorI8 v, VectorI8 min, VectorI8 max) { return minI8(maxI8(v, min), max); }
+        SP_ALWAYS_INLINE_NDEBUG inline VectorI8 addI8(VectorI8 a, VectorI8 b) { return _mm_add_epi8(a, b); }
+        SP_ALWAYS_INLINE_NDEBUG inline VectorI8 subI8(VectorI8 a, VectorI8 b) { return _mm_sub_epi8(a, b); }
+        SP_ALWAYS_INLINE_NDEBUG inline VectorI8 shiftLeftI8(VectorI8 v, i32 shift) {
+            SP_UNUSED(v, shift);
+            unimplemented();
+        }
+
+        SP_ALWAYS_INLINE_NDEBUG inline VectorI16 zeroI16() { return _mm_setzero_si128(); }
+        SP_ALWAYS_INLINE_NDEBUG inline VectorI16 set1I16(i16 v) { return _mm_set1_epi16(v); }
+        SP_ALWAYS_INLINE_NDEBUG inline VectorI16 loadI16(const void* ptr) {
+            assert(isAligned<kAlignment>(ptr));
+            return _mm_load_si128(static_cast<const VectorI16*>(ptr));
+        }
+        SP_ALWAYS_INLINE_NDEBUG inline void storeI16(void* ptr, VectorI16 v) {
+            assert(isAligned<kAlignment>(ptr));
+            _mm_store_si128(static_cast<VectorI16*>(ptr), v);
+        }
+        SP_ALWAYS_INLINE_NDEBUG inline VectorI16 widenLoadI8ToI16(const void* ptr) {
+            return _mm_cvtepi8_epi16(_mm_loadl_epi64(static_cast<const __m128i*>(ptr)));
+        }
+        SP_ALWAYS_INLINE_NDEBUG inline VectorI16 minI16(VectorI16 a, VectorI16 b) { return _mm_min_epi16(a, b); }
+        SP_ALWAYS_INLINE_NDEBUG inline VectorI16 maxI16(VectorI16 a, VectorI16 b) { return _mm_max_epi16(a, b); }
+        SP_ALWAYS_INLINE_NDEBUG inline VectorI16 clampI16(VectorI16 v, VectorI16 min, VectorI16 max) { return minI16(maxI16(v, min), max); }
+        SP_ALWAYS_INLINE_NDEBUG inline VectorI16 addI16(VectorI16 a, VectorI16 b) { return _mm_add_epi16(a, b); }
