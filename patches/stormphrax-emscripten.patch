@@ -0,0 +1,109 @@
+/* Scalar geometry fallback for the Stormphrax browser/WebAssembly port. */
+#pragma once
+
+#include "../../../../types.h"
+
+#include <array>
+#include <cstring>
+#include <span>
+#include <tuple>
+
+namespace stormphrax::eval::nnue::features::threats::geometry {
+    struct Vector {
+        std::array<u8, 64> raw{};
+
+        [[nodiscard]] Vector flip() const {
+            Vector out{};
+            std::copy(raw.begin() + 32, raw.end(), out.raw.begin());
+            std::copy(raw.begin(), raw.begin() + 32, out.raw.begin() + 32);
+            return out;
+        }
+
+        [[nodiscard]] Bitrays toMask() const {
+            Bitrays out{};
+            for (u32 i = 0; i < 64; ++i) if (raw[i]) out |= Bitrays{1} << i;
+            return out;
+        }
+
+        [[nodiscard]] static Vector load(const void* ptr) {
+            Vector out{};
+            std::memcpy(out.raw.data(), ptr, out.raw.size());
+            return out;
+        }
+
+        template <typename T>
+        [[nodiscard]] static Vector cast(const T& value)
+            requires(sizeof(T) == 64)
+        {
+            return load(&value);
+        }
+    };
+
+    struct Permutation {
+        Vector indexes;
+        Vector valid;
+    };
+
+    [[nodiscard]] inline Permutation permutationFor(Square focus) {
+        const auto indexes = Vector::load(kPermutationTable[focus.idx()].data());
+        Vector valid{};
+        for (u32 i = 0; i < 64; ++i) valid.raw[i] = indexes.raw[i] < 64 ? 0xFF : 0;
+        return {indexes, valid};
+    }
+
+    [[nodiscard]] inline std::tuple<Vector, Vector> permuteMailbox(const Permutation& permutation, Vector mailbox) {
+        Vector permuted{};
+        Vector bits{};
+        for (u32 i = 0; i < 64; ++i) {
+            if (!permutation.valid.raw[i]) continue;
+            const auto piece = mailbox.raw[permutation.indexes.raw[i]];
+            permuted.raw[i] = piece;
+            bits.raw[i] = kPieceToBitTable[piece];
+        }
+        return {permuted, bits};
+    }
+
+    [[nodiscard]] inline std::tuple<Vector, Vector> permuteMailbox(
+        const Permutation& permutation,
+        const std::span<const Piece, Squares::kCount> mailbox
+    ) {
+        return permuteMailbox(permutation, Vector::load(mailbox.data()));
+    }
+
+    [[nodiscard]] inline std::tuple<Vector, Vector> permuteMailbox(
+        const Permutation& permutation,
+        const std::span<const Piece, Squares::kCount> mailbox,
+        Square ignore
+    ) {
+        auto copy = Vector::load(mailbox.data());
+        copy.raw[ignore.idx()] = static_cast<u8>(Pieces::kNone.idx());
+        return permuteMailbox(permutation, copy);
+    }
+
+    [[nodiscard]] inline Bitrays closestOccupied(Vector bits) {
+        const auto occupied = bits.toMask();
+        const Bitrays withEnds = occupied | 0x8181818181818181ULL;
+        return (withEnds ^ (withEnds - 0x0303030303030303ULL)) & occupied;
+    }
+
+    [[nodiscard]] inline Bitrays rayFill(Bitrays br) {
+        br = (br + 0x7E7E7E7E7E7E7E7EULL) & 0x8080808080808080ULL;
+        return br - (br >> 7);
+    }
+
+    [[nodiscard]] inline Bitrays outgoingThreats(Piece piece, Bitrays closest) {
+        return kOutgoingThreatsTable[piece.idx()] & closest;
+    }
+
+    [[nodiscard]] inline Bitrays incomingAttackers(Vector bits, Bitrays closest) {
+        Bitrays out{};
+        for (u32 i = 0; i < 64; ++i) if (bits.raw[i] & kIncomingThreatsMask[i]) out |= Bitrays{1} << i;
+        return out & closest;
+    }
+
+    [[nodiscard]] inline Bitrays incomingSliders(Vector bits, Bitrays closest) {
+        Bitrays out{};
+        for (u32 i = 0; i < 64; ++i) if (bits.raw[i] & kIncomingSlidersMask[i]) out |= Bitrays{1} << i;
+        return out & closest & 0xFEFEFEFEFEFEFEFEULL;
+    }
+} // namespace stormphrax::eval::nnue::features::threats::geometry
