{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!.claude",
      "!public",
      "!src/styles",
      "!package-lock.json",
      "!.svelte-kit",
      "!dist-client",
      "!.deploy-public",
      "!src/lc0/generated",
      "!src/lc0/generatedPolicyMap.ts",
      "!fixtures",
      "!engines"
    ]
  },
  "plugins": ["./lint/no-hand-rolled-queue.grit"],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 160
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": "off",
      "complexity": "off"
    }
  },
  "markdown": { "formatter": { "enabled": false }, "linter": { "enabled": false } },
  "yaml": { "formatter": { "enabled": false }, "linter": { "enabled": false } },
  "overrides": [
    {
      "includes": [
        "scripts/analysis_ux_browser_smoke.mjs",
        "scripts/engine_integrity_browser_smoke.mjs",
        "scripts/memory_harness/run.mjs",
        "scripts/uat/probe.mjs",
        "tests/uat_recorder.test.mjs"
      ],
      "linter": {
        "rules": {
          "performance": {
            "useDomNodeTextContent": "off"
          }
        }
      }
    },
    {
      "includes": ["src/app.html"],
      "linter": {
        "rules": {
          "correctness": {
            "noInnerDeclarations": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.svelte"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    }
  ]
}
