{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!.claude",
      "!public",
      "!package-lock.json",
      "!.svelte-kit",
      "!dist-client",
      "!.deploy-public",
      "!src/lc0/generated",
      "!src/lc0/generatedPolicyMap.ts",
      "!fixtures",
      "!engines"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 160
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": "off",
      "complexity": "off"
    }
  },
  "overrides": [
    {
      "includes": ["src/app.html"],
      "linter": {
        "rules": {
          "correctness": {
            "noInnerDeclarations": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.svelte"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    }
  ]
}
